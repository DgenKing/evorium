{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorium.invalid/city/buildings.schema.json",
  "title": "Evorium city buildings",
  "type": "object",
  "required": ["schema_version", "snapshot", "buildings"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot": {"type": "string"},
    "buildings": {"type": "array", "items": {"type": "object", "required": ["id", "geometry", "height_m", "height_source", "type", "roof"], "properties": {
      "id": {"type": "string"}, "geometry": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}}},
      "height_m": {"type": "number", "exclusiveMinimum": 0}, "height_source": {"enum": ["lidar", "osm_levels", "default"]},
      "levels": {"type": ["integer", "null"], "minimum": 1}, "type": {"enum": ["terrace", "mill_warehouse", "modern_flats", "shop", "other"]},
      "roof": {"enum": ["flat", "gable", "hip", "other"]}, "properties": {"type": "object"}
    }}}
  },
  "additionalProperties": false
}
