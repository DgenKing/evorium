{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorium.invalid/city/buildings.schema.json",
  "title": "Evorium city buildings",
  "type": "object",
  "required": ["schema_version", "snapshot", "height_counts", "buildings"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot": {"type": "string"},
    "height_counts": {"type": "object", "required": ["lidar", "osm_levels", "default", "override"], "properties": {
      "lidar": {"type": "integer", "minimum": 0}, "osm_levels": {"type": "integer", "minimum": 0}, "default": {"type": "integer", "minimum": 0}, "override": {"type": "integer", "minimum": 0}
    }, "additionalProperties": false},
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "geometry", "height_m", "height_source", "type", "roof"],
        "properties": {
          "id": {"type": "string"},
          "geometry": {
            "oneOf": [
              {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "Polygon"}, "coordinates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ring"}}}, "additionalProperties": true},
              {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "MultiPolygon"}, "coordinates": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ring"}}}}, "additionalProperties": true}
            ]
          },
          "height_m": {"type": "number", "exclusiveMinimum": 0},
          "height_source": {"enum": ["lidar", "osm_levels", "default", "override"]},
          "levels": {"type": ["integer", "null"], "minimum": 1},
          "type": {"enum": ["terrace", "mill_warehouse", "modern_flats", "shop", "other"]},
          "roof": {"enum": ["flat", "gabled", "hipped", "pyramidal", "mansard", "skillion", "gable", "hip", "other"]},
          "properties": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "point2": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "ring": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/point2"}}
  },
  "additionalProperties": false
}
