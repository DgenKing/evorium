{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorium.invalid/city/navmesh.schema.json",
  "title": "Evorium walkable navigation mesh",
  "type": "object",
  "required": ["schema_version", "vertices", "polygons", "portals"],
  "properties": {"schema_version": {"const": 1}, "vertices": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
    "polygons": {"type": "array", "items": {"type": "array", "minItems": 3, "items": {"type": "integer", "minimum": 0}}},
    "portals": {"type": "array", "items": {"type": "object", "required": ["a", "b", "from", "to", "cost"], "properties": {
      "a": {"type": "integer", "minimum": 0}, "b": {"type": "integer", "minimum": 0}, "from": {"type": "integer", "minimum": 0}, "to": {"type": "integer", "minimum": 0}, "cost": {"type": "number", "minimum": 0}
    }}},
    "graph": {"type": "object", "required": ["nodes", "edges"], "properties": {
      "nodes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/vec3"}},
      "edges": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}}
    }, "additionalProperties": false}
  },
  "$defs": {"vec3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3}},
  "additionalProperties": false
}
