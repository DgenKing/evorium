{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorium.invalid/city/navmesh.schema.json",
  "title": "Evorium street route graph",
  "type": "object",
  "required": ["schema_version", "graph"],
  "properties": {
    "schema_version": {"const": 1},
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/vec3"}},
        "edges": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}}
      },
      "additionalProperties": false
    }
  },
  "$defs": {"vec3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3}},
  "additionalProperties": false
}
